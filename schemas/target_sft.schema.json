{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepoSpec Target SFT Example",
  "type": "object",
  "required": [
    "repo",
    "repo_id",
    "repo_url",
    "commit",
    "split",
    "question_id",
    "question",
    "answer",
    "messages",
    "loss_on",
    "evidence_files",
    "evidence_spans",
    "task_type",
    "source",
    "generator",
    "quality_flags"
  ],
  "properties": {
    "repo": { "type": "string" },
    "repo_id": { "type": "string" },
    "repo_url": { "type": "string" },
    "commit": { "type": "string" },
    "split": { "const": "target_sft_train" },
    "question_id": { "type": "string" },
    "question": { "type": "string", "minLength": 10 },
    "answer": { "type": "string", "minLength": 10 },
    "messages": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": { "enum": ["system", "user", "assistant"] },
          "content": { "type": "string" }
        }
      }
    },
    "loss_on": { "const": "assistant_only" },
    "evidence_files": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "evidence_spans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "start_line", "end_line"],
        "properties": {
          "path": { "type": "string" },
          "start_line": { "type": "integer", "minimum": 1 },
          "end_line": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "task_type": { "const": "repo_qa" },
    "source": { "type": "string" },
    "generator": { "type": "string" },
    "quality_flags": { "type": "object" }
  }
}
